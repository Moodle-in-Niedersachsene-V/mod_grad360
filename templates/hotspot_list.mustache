{{!
    @template mod_grad360/hotspot_list

    List of hotspots for accessibility and overview.

    Context variables required for this template:
    * hotspots - Array of hotspot objects
    * showstatus - Whether to show visit status

    Example context (json):
    {
        "hotspots": [
            {
                "id": 1,
                "title": "Entrance",
                "text": "Main entrance",
                "haslink": true,
                "link": "https://example.com",
                "required": true,
                "visited": false,
                "caninteract": true
            }
        ],
        "showstatus": true
    }
}}
<div class="grad360-hotspot-list mt-3">
    <h4>{{#str}} hotspots, mod_grad360 {{/str}}</h4>
    <ul class="list-group">
        {{#hotspots}}
        <li class="list-group-item grad360-hotspot-list-item d-flex justify-content-between align-items-start" data-id="{{id}}">
            <div class="ms-2 me-auto">
                <div class="fw-bold">
                    {{title}}
                    {{#required}}
                    <span class="badge bg-info text-dark ms-1" title="{{#str}} required, mod_grad360 {{/str}}">
                        {{#str}} required, mod_grad360 {{/str}}
                    </span>
                    {{/required}}
                </div>
                {{#text}}
                <small class="text-muted">{{{text}}}</small>
                {{/text}}
                {{#haslink}}
                <div>
                    <a href="{{link}}" target="_blank" rel="noopener" class="small">
                        {{link}}
                    </a>
                </div>
                {{/haslink}}
            </div>
            {{#showstatus}}
            <span class="grad360-status-badge badge {{#visited}}bg-success{{/visited}}{{^visited}}bg-secondary{{/visited}}">
                {{#visited}}{{#str}} visited, mod_grad360 {{/str}}{{/visited}}
                {{^visited}}{{#str}} notvisited, mod_grad360 {{/str}}{{/visited}}
            </span>
            {{/showstatus}}
        </li>
        {{/hotspots}}
    </ul>
</div>
