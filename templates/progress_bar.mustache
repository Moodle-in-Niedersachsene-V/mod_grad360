{{!
    @template mod_grad360/progress_bar

    Progress bar for hotspot completion.

    Context variables required for this template:
    * percent - Progress percentage (0-100)
    * visited - Number of visited required hotspots
    * total - Total number of required hotspots
    * complete - Whether all required hotspots have been visited
    * progresstext - Localized progress text

    Example context (json):
    {
        "percent": 50,
        "visited": 2,
        "total": 4,
        "complete": false,
        "progresstext": "2 of 4 required hotspots visited"
    }
}}
<div class="grad360-progress mb-3">
    <div class="grad360-progress-text small text-muted mb-1">
        {{{progresstext}}}
    </div>
    <div class="grad360-progress-bar progress" style="height: 20px;">
        <div class="progress-bar {{#complete}}bg-success{{/complete}}{{^complete}}bg-primary{{/complete}}"
             role="progressbar"
             style="width: {{percent}}%;"
             aria-valuenow="{{percent}}"
             aria-valuemin="0"
             aria-valuemax="100">
            {{percent}}%
        </div>
    </div>
    {{#complete}}
    <div class="grad360-complete-message alert alert-success mt-2" role="status">
        {{#str}} allhotspotsvisited, mod_grad360 {{/str}}
    </div>
    {{/complete}}
    {{^complete}}
    <div class="grad360-complete-message alert alert-success mt-2" role="status" style="display: none;">
        {{#str}} allhotspotsvisited, mod_grad360 {{/str}}
    </div>
    {{/complete}}
</div>
